# Variables d'environnement d'un agent BaolSec (copier en /etc/baolsec-agent/agent.env, droits 600).
BAOLSEC_GATEWAY_HOST=baolsec.example.local     # nom présent dans le certificat de la passerelle
BAOLSEC_GATEWAY_PORT=8443
BAOLSEC_SOURCE_TOKEN=                          # jeton de cette source (affiché une seule fois à sa création)
BAOLSEC_CA_FILE=/etc/baolsec-agent/sources-ca.crt
BAOLSEC_STATE_DIR=/var/lib/baolsec-agent       # tampon disque et positions de lecture
BAOLSEC_BUFFER_LIMIT=1G                        # taille maximale du tampon disque

# Agent webapp uniquement
BAOLSEC_WEBAPP_ACCESS_LOG=/var/log/nginx/access.log
BAOLSEC_WEBAPP_APP_LOG=/var/log/monapp/app.log

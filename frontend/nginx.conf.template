# Interface BaolSec : fichiers statiques de l'application et relais vers l'API.
# ES-04 : le navigateur ne parle qu'en HTTPS (TLS 1.2+) ; HTTP redirige vers HTTPS.
# Certificat : /etc/nginx/certs/frontend.crt et .key (développement : make gateway-dev,
# scripts/development/init_dev_gateway.sh ; production : certificat de l'organisation).
#
# Modèle : l'image nginx le recopie dans /etc/nginx/conf.d/default.conf au démarrage en remplaçant
# ${FRONTEND_HTTPS_PORT} (port HTTPS publié sur la machine, variable du même nom dans .env). Seules
# les variables FRONTEND_* sont remplacées (NGINX_ENVSUBST_FILTER) : $host, $uri… restent à nginx.

server {
    listen 80;
    server_name _;
    location = /health { return 200 "ok\n"; add_header Content-Type text/plain; }
    location / { return 301 https://$host:${FRONTEND_HTTPS_PORT}$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/frontend.crt;
    ssl_certificate_key /etc/nginx/certs/frontend.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;
    server_tokens off;

    # En-têtes de sécurité (ES-05, ES-06) : pas de script tiers, pas d'intégration en cadre.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Fichiers de l'application avec empreinte Vite : mis en cache longtemps
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Relais vers l'API (même chemin /api/v1, pas de réécriture)
    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Application monopage : toutes les routes de l'interface → index.html (jamais mis en cache)
    location / {
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri $uri/ /index.html;
    }
}

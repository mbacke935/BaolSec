digraph G { graph [rankdir=LR, fontname="DejaVu Sans", labelloc=t, label=<<b>MLD — Schéma acces (écrivain : API)</b><br/> >, fontsize=20, dpi=200, nodesep=0.4, ranksep=0.9, pad=0.3]; node [shape=plain, fontname="DejaVu Sans", fontsize=11]; edge [color="#37474F", arrowsize=0.8, fontname="DejaVu Sans", fontsize=9];

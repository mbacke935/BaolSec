LEG [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="4" color="#90A4AE"><tr><td colspan="2" bgcolor="#ECEFF1"><b>Légende</b></td></tr><tr><td>trait plein, pointe pleine</td><td align="left">clé étrangère dans le même schéma (de la table qui référence vers la table référencée)</td></tr><tr><td>tirets gris</td><td align="left">clé étrangère vers une table d'un autre schéma, lue sans droit d'écriture</td></tr><tr><td>cadre en tirets</td><td align="left">table d'un autre schéma</td></tr><tr><td><u>souligné</u> · PK · FK · UQ</td><td align="left">clé primaire · clé étrangère · contrainte d'unicité</td></tr></table>>];

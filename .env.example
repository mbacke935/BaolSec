# =============================================================================
# BaolSec — variables de déploiement (copier en .env, droits 600, jamais versionné).
# Générer chaque secret avec : openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# =============================================================================

# --- PostgreSQL (C4) ---------------------------------------------------------
POSTGRES_DB=baolsec
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_PASSWORD=<secret>

# Un compte par service, droits minimaux (infrastructure/database/sql/0005_comptes.sql)
SVC_API_PASSWORD=<secret>
SVC_PASSERELLE_PASSWORD=<secret>
SVC_NORMALISATION_PASSWORD=<secret>
SVC_DETECTION_PASSWORD=<secret>
SVC_INCIDENTS_PASSWORD=<secret>
SVC_COUVERTURE_PASSWORD=<secret>

# --- Broker NATS JetStream (ADR 0002) ----------------------------------------
BROKER_URL=nats://broker:4222
BROKER_TOKEN=<secret>
STATE_STORE_URL=nats://broker:4222

# --- Référentiel des sources de la passerelle et de la normalisation ---------
# postgres : les sources et identifiants créés dans l'interface (Sources › Ajouter une source)
#            sont pris en compte en quelques secondes. Valeur à utiliser pour la plateforme.
# file     : fichier de développement infrastructure/tls/dev/sources.json (tests de C6 uniquement).
GATEWAY_SOURCE_REGISTRY=postgres
GATEWAY_POSTGRES_DSN=postgresql://svc_passerelle:${SVC_PASSERELLE_PASSWORD}@postgresql:5432/baolsec
NORMALIZER_SOURCE_REGISTRY=postgres
NORMALIZER_POSTGRES_DSN=postgresql://svc_normalisation:${SVC_NORMALISATION_PASSWORD}@postgresql:5432/baolsec
NORMALIZER_SYSLOG_TIMEZONE=UTC
# Réseaux internes (CIDR séparés par des virgules) pour l'enrichissement network.direction
NORMALIZER_INTERNAL_NETWORKS=

# --- OpenSearch --------------------------------------------------------------
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USER=admin
# Mot de passe initial du compte admin (12 caractères au moins, majuscule, chiffre, caractère spécial)
OPENSEARCH_PASSWORD=<secret>
# Certificat de l'autorité d'OpenSearch : la vérification TLS est activée dès qu'il est fourni.
OPENSEARCH_CA_CERT=
OPENSEARCH_VERIFY_CERTS=false

# --- API et interface --------------------------------------------------------
JWT_SECRET=<secret de 32 caractères au moins>
# Jeton partagé entre l'API et le service Incidents pour les commandes (C5 section 6)
INCIDENTS_COMMAND_TOKEN=<secret>
# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules)
CORS_ORIGINS=https://localhost
# Ports publiés de l'interface. La redirection HTTP → HTTPS suit FRONTEND_HTTPS_PORT
# (ex. 9443 si le port 443 est déjà pris par un autre service de la machine).
FRONTEND_HTTPS_PORT=443
FRONTEND_HTTP_PORT=80

# --- Détection ---------------------------------------------------------------
DETECTOR_RULES_SOURCE=postgres
DETECTOR_RULES_REFRESH_S=30
DETECTOR_PENDING_INTERVAL_S=60

# --- Conservation et sauvegardes (ES-09) -------------------------------------
EVENTS_RETENTION_DAYS=90
SNAPSHOT_KEEP=14
BACKUP_RETENTION_DAYS=14

# --- Supervision (Grafana sur 127.0.0.1:3001) ---------------------------------
GRAFANA_PASSWORD=<secret>

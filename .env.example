# Copier en .env (jamais versionné) puis remplir.
POSTGRES_DB=baolsec
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
OPENSEARCH_URL=https://opensearch:9200

# Broker NATS JetStream (ADR 0002). Générer le jeton avec : openssl rand -hex 32
BROKER_URL=nats://broker:4222
BROKER_TOKEN=
# Bucket KV de l'état des règles, servi par le même broker
STATE_STORE_URL=nats://broker:4222

{
  "description": "Flux et consommateurs durables de BaolSec (ADR 0002). Durées en secondes, tailles en octets. RAW_EVENTS : un message est supprimé dès que tous ses consommateurs l'ont acquitté (interest) ; plein, il refuse les nouveaux messages (la passerelle répond 503 et les agents gardent les événements dans leur tampon). Les autres flux sont conservés pour la relecture. Consommateurs : le broker relivre sans limite (max_deliver = -1) ; le nombre de tentatives (attempts) est compté par baolsec_common.messaging.process, qui envoie le message en file de rejet après la 5e (C11).",
  "stream_defaults": {
    "storage": "file",
    "retention": "limits",
    "discard": "old",
    "duplicate_window": 600,
    "max_msg_size": 1048576,
    "num_replicas": 1
  },
  "consumer_defaults": {
    "ack_policy": "explicit",
    "deliver_policy": "all",
    "max_deliver": -1,
    "attempts": 5,
    "backoff": [
      5,
      15,
      30,
      60
    ],
    "max_ack_pending": 1000
  },
  "streams": [
    {
      "name": "RAW_EVENTS",
      "subjects": [
        "raw-events"
      ],
      "max_age": 604800,
      "max_bytes": 21474836480,
      "consumers": [
        "normalization",
        "coverage-raw"
      ],
      "retention": "interest",
      "discard": "new"
    },
    {
      "name": "NORMALIZED_EVENTS",
      "subjects": [
        "normalized-events"
      ],
      "max_age": 604800,
      "max_bytes": 21474836480,
      "consumers": [
        "detection",
        "indexing-events",
        "coverage-normalized"
      ]
    },
    {
      "name": "ALERTS",
      "subjects": [
        "alerts"
      ],
      "max_age": 604800,
      "max_bytes": 2147483648,
      "consumers": [
        "incident-builder",
        "indexing-alerts"
      ]
    },
    {
      "name": "INCIDENTS",
      "subjects": [
        "incidents"
      ],
      "max_age": 604800,
      "max_bytes": 2147483648,
      "consumers": [
        "indexing-incidents"
      ]
    },
    {
      "name": "DLQ",
      "subjects": [
        "dlq.>"
      ],
      "max_age": 2592000,
      "max_bytes": 2147483648,
      "discard": "new",
      "consumers": []
    }
  ]
}

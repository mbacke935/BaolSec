# Outil ponctuel C26 : charge seulement les sources et règles de test dans PostgreSQL C26.
FROM python:3.12-slim
RUN pip install --no-cache-dir "psycopg[binary]==3.3.8" pyyaml==6.0.2 jsonschema==4.26.0
WORKDIR /app
COPY infrastructure/database/seed_dev.py infrastructure/database/load_rules.py /app/infrastructure/database/
COPY shared/contracts /app/shared/contracts
COPY rules /app/rules
CMD ["sh", "-ec", "python infrastructure/database/seed_dev.py && python infrastructure/database/load_rules.py"]

{
  "description": "Topologie JetStream C26 isolée. Les durables correspondent exactement aux valeurs par défaut des workers actuels.",
  "stream_defaults": {
    "storage": "file",
    "retention": "limits",
    "discard": "old",
    "duplicate_window": 600,
    "max_msg_size": 1048576,
    "num_replicas": 1
  },
  "consumer_defaults": {
    "ack_policy": "explicit",
    "deliver_policy": "all",
    "max_deliver": -1,
    "attempts": 5,
    "backoff": [5, 15, 30, 60],
    "max_ack_pending": 1000
  },
  "streams": [
    {
      "name": "RAW_EVENTS",
      "subjects": ["raw-events"],
      "max_age": 604800,
      "max_bytes": 21474836480,
      "retention": "interest",
      "discard": "new",
      "consumers": ["normalization", "coverage-worker-raw"]
    },
    {
      "name": "NORMALIZED_EVENTS",
      "subjects": ["normalized-events"],
      "max_age": 604800,
      "max_bytes": 21474836480,
      "consumers": ["detection", "indexing-normalized", "coverage-worker-norm"]
    },
    {
      "name": "ALERTS",
      "subjects": ["alerts"],
      "max_age": 604800,
      "max_bytes": 2147483648,
      "consumers": ["incident-builder", "indexing-alerts"]
    },
    {
      "name": "INCIDENTS",
      "subjects": ["incidents"],
      "max_age": 604800,
      "max_bytes": 2147483648,
      "consumers": ["indexing-incidents"]
    },
    {
      "name": "DLQ",
      "subjects": ["dlq.>"],
      "max_age": 2592000,
      "max_bytes": 2147483648,
      "discard": "new",
      "consumers": []
    }
  ]
}

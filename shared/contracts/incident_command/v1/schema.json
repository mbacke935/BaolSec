{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baolsec.local/contracts/incident_command/v1/schema.json",
  "title": "incident_command/v1",
  "description": "Commande envoyée par l'API au service incident-builder (appel HTTP interne authentifié). Idempotente grâce à command_id : une commande déjà reçue renvoie le résultat enregistré sans être réappliquée (C3 2.5, C4 incident_commands).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "incident_command/v1"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "command_type": {
      "enum": [
        "changer_statut",
        "commenter",
        "clore",
        "rouvrir",
        "assigner",
        "statut_alerte",
        "assigner_alerte"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "type": "string",
          "format": "uuid"
        },
        "alert_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "issued_by": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "username": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "user_id",
        "username"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "contract",
    "command_id",
    "command_type",
    "target",
    "issued_by",
    "issued_at",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "changer_statut"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "required": [
              "incident_id"
            ],
            "not": {
              "required": [
                "alert_id"
              ]
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "ouvert",
                  "en_cours",
                  "clos"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "commenter"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "required": [
              "incident_id"
            ],
            "not": {
              "required": [
                "alert_id"
              ]
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            },
            "required": [
              "body"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "clore"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "required": [
              "incident_id"
            ],
            "not": {
              "required": [
                "alert_id"
              ]
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "rouvrir"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "required": [
              "incident_id"
            ],
            "not": {
              "required": [
                "alert_id"
              ]
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "maxLength": 2000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "assigner"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "required": [
              "incident_id"
            ],
            "not": {
              "required": [
                "alert_id"
              ]
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "assignee_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "assignee_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "statut_alerte"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "required": [
              "alert_id"
            ],
            "not": {
              "required": [
                "incident_id"
              ]
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "nouvelle",
                  "en_cours",
                  "cloturee"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "assigner_alerte"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "required": [
              "alert_id"
            ],
            "not": {
              "required": [
                "incident_id"
              ]
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "assignee_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "assignee_id"
            ]
          }
        }
      }
    }
  ]
}
